# Unified backend monolith env vars.
# Copy to .env and fill in real values for local runs.

# HTTP
MONOLITH_PORT=8080
LOG_LEVEL=debug

# Postgres + Redis
DATABASE_URL=postgres://preuni:preuni@localhost:5432/preuni?sslmode=disable
REDIS_URL=redis://localhost:6379

# Service-to-service token (auth/user/mail internal endpoints)
INTERNAL_SERVICE_TOKEN=dev-internal-token

# JWT
JWT_SIGNING_KEY=dev-signing-key-change-in-prod
JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_DAYS=30

# Self-loopback for in-monolith service-to-service HTTP calls
SELF_BASE_URL=http://localhost:8080

# Avatar storage
S3_BUCKET=preuni-avatars
S3_REGION=us-east-1

# Mail / SMTP — leave SMTP_HOST empty to use NoopSender (no delivery)
FROM_EMAIL=noreply@preuni.com.br
MAIL_FROM_NAME=PreUni
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WELCOME email verification link base
APP_VERIFICATION_BASE_URL=https://app.preuni.com.br/verify-email
