# Application Environment Configuration
# Copy this file to .env and adjust values for your environment
#
# Constitution v2.1.1 / specs/014-constitution-alignment-refactor: this
# service is internal-only now -- JWT/SMTP/quota/CORS/rate-limiting/LGPD
# feature-flag vars were removed as dead config (the Go monolith owns all
# of identity, quota, and end-user data now).

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=INFO

# Database (schema `correction` -- shared Postgres instance with the Go
# monolith per research.md #1, not a separate database)
DATABASE_URL=postgresql+asyncpg://corretor:corretor@postgres:5432/corretor_db
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true

# LLM Provider Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=kimi-k2:1t
OLLAMA_API_KEY=

# Ollama Cloud (for production)
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://api.ollama.ai

# Prompt Configuration
PROMPT_VERSION=v1.0.8
PROMPT_TEMPERATURE=0.1

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HEADERS=
PROMETHEUS_ENABLED=true
LOG_FORMAT=json
LOG_LEVEL=INFO

# Essay validation limits
ESSAY_MIN_LENGTH=500
ESSAY_MAX_LENGTH=3500
ESSAY_MIN_LINES=7
ESSAY_MAX_LINES=50

# Worker Configuration
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=5
WORKER_LOG_LEVEL=INFO

# Backup Configuration (optional)
BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_SCHEDULE=0 3 * * *

# Feature Flags
FEATURE_REEVALUATION=true
FEATURE_GOLDEN_METRICS_ONLY=false

# Testing (development only)
TEST_MODE=false
TESTING=false
DATABASE_TEST_URL=sqlite+aiosqlite:///:memory:

# Logging & Monitoring
PII_SCRUB_ENABLED=true
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=true
