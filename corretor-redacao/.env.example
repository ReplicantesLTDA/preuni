# Application Environment Configuration
# Copy this file to .env and adjust values for your environment

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://corretor:corretor@postgres:5432/corretor_db
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true

# Authentication & Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP Configuration (for email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@corretor-redacao.example.com
SMTP_USE_TLS=true

# LLM Provider Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=kimi-k2:1t
OLLAMA_API_KEY=

# Ollama Cloud (for production)
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://api.ollama.ai

# Prompt Configuration
PROMPT_VERSION=v1.0.8
PROMPT_TEMPERATURE=0.1

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HEADERS=
PROMETHEUS_ENABLED=true
LOG_FORMAT=json
LOG_LEVEL=INFO

# Features & Limits
ESSAY_MIN_LENGTH=500
ESSAY_MAX_LENGTH=3500
ESSAY_MIN_LINES=7
ESSAY_MAX_LINES=50
FREE_TIER_MONTHLY_QUOTA=3
PREMIUM_TIER_MONTHLY_QUOTA=30
QUOTA_RESET_UTC_DAY=1
QUOTA_RESET_UTC_HOUR=0

# Worker Configuration
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=5
WORKER_LOG_LEVEL=INFO

# Backup Configuration (optional)
BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_SCHEDULE=0 3 * * *

# LGPD & Privacy
ZERO_DATA_RETENTION=true
ALLOW_DATA_TRAINING=false
USER_DELETION_GRACE_PERIOD_DAYS=15

# Feature Flags
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PARENTAL_CONSENT=true
FEATURE_REEVALUATION=true
FEATURE_GOLDEN_METRICS_ONLY=false

# Testing (development only)
TEST_MODE=false
TESTING=false
DATABASE_TEST_URL=sqlite+aiosqlite:///:memory:

# Security Headers
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# Logging & Monitoring
PII_SCRUB_ENABLED=true
AUDIT_LOG_ENABLED=true
METRICS_ENABLED=true
