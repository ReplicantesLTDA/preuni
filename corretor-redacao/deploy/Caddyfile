{$DOMAIN} {
    # Auto-TLS via Let's Encrypt.
    tls {$ACME_EMAIL}

    # Request body limit (defense in depth, spec §payload_too_large).
    request_body {
        max_size 1MB
    }

    # Per-IP rate limit on auth endpoints (10 req/10s = 60 req/min).
    @auth_paths {
        path /auth/*
    }
    rate_limit @auth_paths {
        zone auth_zone {
            key {remote_host}
            events 10
            window 10s
        }
    }

    # Reverse proxy to API container.
    reverse_proxy api:8000 {
        health_uri /healthz
        health_interval 10s
        health_timeout 5s
    }
}
