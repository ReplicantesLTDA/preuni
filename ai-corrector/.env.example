# Application Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Only for standalone, non-Docker dev of this service (`make test-int`,
# `make lint`, `make correct-sample`, etc. -- ai-corrector/Makefile
# auto-loads .env). For the shared Docker Compose stack, see
# ../infra/.env.example instead.
#
# Constitution v2.1.1 / specs/014-constitution-alignment-refactor: this
# service is internal-only now -- JWT/SMTP/quota/CORS/rate-limiting/LGPD
# feature-flag vars were removed as dead config (the Go monolith owns all
# of identity, quota, and end-user data now).
#
# specs/032-corrector-service-integration/: every var below is actually
# read somewhere in src/ -- verified by grep before trimming this file.
# It previously carried ~30 vars from the original standalone product
# that nothing in src/ ever consulted (API_HOST/PORT, WORKER_BATCH_SIZE,
# BACKUP_*, FEATURE_*, etc.) -- removed rather than left as silent no-ops.

# Database (schema `correction` -- shared Postgres instance with the Go
# monolith per research.md #1, not a separate database)
DATABASE_URL=postgresql+asyncpg://corretor:corretor@postgres:5432/corretor_db
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600

# LLM provider: set OLLAMA_CLOUD_API_KEY to grade via Ollama Cloud;
# leave empty to fall back to OLLAMA_BASE_URL (a local Ollama you run
# yourself). OLLAMA_API_KEY is a legacy alias src/scripts/correct_essay.py
# still falls back to if OLLAMA_CLOUD_API_KEY is unset.
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=kimi-k2.6

# Prompt Configuration
PROMPT_VERSION=v1.0.8

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Testing (development only) -- integration tests read this, not
# DATABASE_URL; matches correction-service-ci.yml's env var name
TEST_DATABASE_URL=postgresql+asyncpg://corretor:corretor@localhost:5432/corretor_test
