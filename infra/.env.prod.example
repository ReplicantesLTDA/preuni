# =============================================================================
# preuni PRODUCTION environment variables -- SHAPE ONLY, not filled in by hand.
#
# specs/035-self-hosted-prod-deploy/research.md R7: every value below lives
# as a GitHub Actions repository secret, not a file someone edits on the
# NAS over SSH. .github/workflows/deploy-prod.yml writes the real
# infra/.env on the NAS fresh on every deploy, sourced from those secrets,
# before bringing the stack up -- rotating a credential is a GitHub
# Settings change, not an SSH session. This file exists so the required
# secret NAMES (and non-secret defaults) are documented in one place; the
# workflow's own env: block is the actual list it reads.
#
# specs/035-self-hosted-prod-deploy/: distinct from infra/.env.example
# (the dev-only shape) -- production credentials MUST differ from dev's,
# never reused across environments.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=preuni
POSTGRES_PASSWORD=CHANGE_ME_distinct_from_dev
POSTGRES_DB=preuni
# Real NAS dataset path pg_dump/NAS-level backups can reach -- not a
# Docker-managed volume (research.md R4/tasks.md T007). Not a secret, but
# NAS-specific, so it's still a GitHub Actions secret/variable rather than
# a value baked into the compose file.
POSTGRES_DATA_PATH=/mnt/CHANGE_ME/preuni/postgres

# --- JWT ---------------------------------------------------------------------
# min 32 chars, distinct from dev's
JWT_SIGNING_KEY=CHANGE_ME_min_32_chars_production_signing_key
JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_DAYS=30

# --- Avatars (MinIO, self-hosted, S3-compatible) ------------------------------
# STORAGE_ENDPOINT must be the second public hostname routed through the
# same Cloudflare Tunnel as the gateway (see tasks.md T008a) -- presigned
# URLs are generated against it, the backend never proxies upload bytes,
# so the uploading client (mobile app) must be able to reach it directly.
STORAGE_ENDPOINT=storage.preuni.com.br
STORAGE_ACCESS_KEY=CHANGE_ME_distinct_from_dev
STORAGE_SECRET_KEY=CHANGE_ME_distinct_from_dev
STORAGE_BUCKET=preuni-avatars
# Real NAS dataset path (same pattern as POSTGRES_DATA_PATH above).
MINIO_DATA_PATH=/mnt/CHANGE_ME/preuni/minio

# --- Mail (in-process SMTP) --------------------------------------------------
# Optional -- see infra/.env.example's note. Real delivery needed in
# production for email verification to actually reach users.
FROM_EMAIL=noreply@preuni.com.br
MAIL_FROM_NAME=PreUni
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@preuni.com.br
SMTP_PASS=

APP_VERIFICATION_BASE_URL=https://preuni.com.br/verify-email

# --- Correction service (ai-corrector, internal-only) -------------------------
# Same shape as infra/.env.example -- see specs/032-corrector-service-integration/.
CORRECTOR_OLLAMA_CLOUD_API_KEY=
CORRECTOR_OLLAMA_CLOUD_BASE_URL=https://ollama.com
CORRECTOR_OLLAMA_BASE_URL=http://ollama:11434
CORRECTOR_OLLAMA_MODEL=kimi-k2.6
CORRECTOR_PROMPT_VERSION=v1.0.8

# --- Ingress (Cloudflare Tunnel) ----------------------------------------------
# From the Cloudflare dashboard's tunnel setup -- see
# specs/035-self-hosted-prod-deploy/tasks.md T008.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backup (pg_dump sidecar, whole shared database) --------------------------
# See specs/035-self-hosted-prod-deploy/research.md R4.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
RETENTION_DAYS=30
