# =============================================================================
# preuni PRODUCTION environment variables.
# Copy to infra/.env on the NAS itself and fill in real values there.
# NEVER commit the real infra/.env -- this file documents shape only.
# docker compose loads infra/.env automatically when run from infra/
# with `-f infra/docker-compose.prod.yml`.
#
# specs/035-self-hosted-prod-deploy/: distinct from infra/.env.example
# (the dev-only shape) -- production credentials MUST differ from dev's,
# never reused across environments.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=preuni
POSTGRES_PASSWORD=CHANGE_ME_distinct_from_dev
POSTGRES_DB=preuni

# --- JWT ---------------------------------------------------------------------
# min 32 chars, distinct from dev's
JWT_SIGNING_KEY=CHANGE_ME_min_32_chars_production_signing_key
JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_DAYS=30

# --- Avatars (S3) ------------------------------------------------------------
S3_BUCKET=preuni-avatars
S3_REGION=us-east-1

# --- Mail (in-process SMTP) --------------------------------------------------
# Optional -- see infra/.env.example's note. Real delivery needed in
# production for email verification to actually reach users.
FROM_EMAIL=noreply@preuni.com.br
MAIL_FROM_NAME=PreUni
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@preuni.com.br
SMTP_PASS=

APP_VERIFICATION_BASE_URL=https://preuni.com.br/verify-email

# --- Correction service (ai-corrector, internal-only) -------------------------
# Same shape as infra/.env.example -- see specs/032-corrector-service-integration/.
CORRECTOR_OLLAMA_CLOUD_API_KEY=
CORRECTOR_OLLAMA_CLOUD_BASE_URL=https://ollama.com
CORRECTOR_OLLAMA_BASE_URL=http://ollama:11434
CORRECTOR_OLLAMA_MODEL=kimi-k2.6
CORRECTOR_PROMPT_VERSION=v1.0.8

# --- Ingress (Cloudflare Tunnel) ----------------------------------------------
# From the Cloudflare dashboard's tunnel setup -- see
# specs/035-self-hosted-prod-deploy/tasks.md T008.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backup (pg_dump sidecar, whole shared database) --------------------------
# See specs/035-self-hosted-prod-deploy/research.md R4.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
RETENTION_DAYS=30
