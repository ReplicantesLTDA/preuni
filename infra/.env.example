# =============================================================================
# preuni backend — environment variables.
# Copy to infra/.env and fill in real values.
# docker compose loads infra/.env automatically when run from infra/.
# Never commit .env.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=preuni
POSTGRES_PASSWORD=preuni
POSTGRES_DB=preuni

# --- JWT ---------------------------------------------------------------------
# min 32 chars
JWT_SIGNING_KEY=CHANGE_ME_min_32_chars_jwt_signing_key
JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_DAYS=30

# --- Avatars (S3) ------------------------------------------------------------
S3_BUCKET=preuni-avatars
S3_REGION=us-east-1

# --- Mail (in-process SMTP) --------------------------------------------------
# Optional -- not required to run the app or the essay-correction flow.
# Leave SMTP_HOST empty to use NoopSender (no delivery, dev default): the
# monolith just skips sending, it doesn't fail. Only needed if you want
# real email delivery (verification links, etc.) locally.
FROM_EMAIL=noreply@preuni.com.br
MAIL_FROM_NAME=PreUni
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@preuni.com.br
SMTP_PASS=

# WELCOME email verification link base
APP_VERIFICATION_BASE_URL=https://app.preuni.com.br/verify-email

# --- Correction service (ai-corrector, internal-only) -------------------------
# Shares the Postgres instance above (schema `correction`) -- see
# specs/032-corrector-service-integration/. No DATABASE_URL of its own:
# built from POSTGRES_* above in infra/docker-compose.yml.
#
# LLM provider: set CORRECTOR_OLLAMA_CLOUD_API_KEY to grade via Ollama
# Cloud (recommended -- this stack does not run a local Ollama
# container). Leave it empty to fall back to CORRECTOR_OLLAMA_BASE_URL,
# which then must point at an Ollama you run yourself.
CORRECTOR_OLLAMA_CLOUD_API_KEY=
CORRECTOR_OLLAMA_CLOUD_BASE_URL=https://ollama.com
CORRECTOR_OLLAMA_BASE_URL=http://ollama:11434
CORRECTOR_OLLAMA_MODEL=kimi-k2.6
CORRECTOR_PROMPT_VERSION=v1.0.8
