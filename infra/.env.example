# =============================================================================
# preuni backend — environment variables.
# Copy to infra/.env and fill in real values.
# docker compose loads infra/.env automatically when run from infra/.
# Never commit .env.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=preuni
POSTGRES_PASSWORD=preuni
POSTGRES_DB=preuni

# --- JWT ---------------------------------------------------------------------
# min 32 chars
JWT_SIGNING_KEY=CHANGE_ME_min_32_chars_jwt_signing_key
JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_DAYS=30

# --- Avatars (S3) ------------------------------------------------------------
S3_BUCKET=preuni-avatars
S3_REGION=us-east-1

# --- Mail (in-process SMTP) --------------------------------------------------
# Leave SMTP_HOST empty to use NoopSender (no delivery — dev).
FROM_EMAIL=noreply@preuni.com.br
MAIL_FROM_NAME=PreUni
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@preuni.com.br
SMTP_PASS=

# WELCOME email verification link base
APP_VERIFICATION_BASE_URL=https://app.preuni.com.br/verify-email
