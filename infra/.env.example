# =============================================================================
# PreUni Backend — environment variables
# Copy to infra/.env and fill in real values.
# docker compose automatically loads infra/.env when run from infra/.
# Never commit .env to version control.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=preuni
POSTGRES_PASSWORD=preuni
POSTGRES_DB=preuni

# --- Shared secrets (all Go services) ----------------------------------------
# JWT signing key — min 32 chars. Used by auth, user, content, learning,
# simulation, dissertation, notification.
JWT_SIGNING_KEY=CHANGE_ME_min_32_chars_jwt_signing_key

# Internal service-to-service shared secret. All services must agree on value.
INTERNAL_SERVICE_TOKEN=CHANGE_ME_strong_random_internal_token

# --- Auth service -------------------------------------------------------------
JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_DAYS=30

# --- Dissertation service -----------------------------------------------------
# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=CHANGE_ME_sk-ant-xxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Mail service (Elixir/Phoenix) --------------------------------------------
# Min 64 random chars. Generate: mix phx.gen.secret
MAIL_SECRET_KEY_BASE=CHANGE_ME_generate_with_mix_phx_gen_secret_min_64_chars

PHX_HOST=localhost
FROM_EMAIL=noreply@preuni.com.br
MAIL_FROM_NAME=PreUni

# Set to "smtp" in production to enable real delivery.
# "local" uses Swoosh in-memory mailbox (emails viewable at /dev/mailbox).
SWOOSH_ADAPTER=local

# SMTP credentials — required only when SWOOSH_ADAPTER=smtp.
#
# Resend:    SMTP_HOST=smtp.resend.com  SMTP_USER=resend  SMTP_PASS=re_xxx
# Postmark:  SMTP_HOST=smtp.postmarkapp.com  SMTP_USER=<token>  SMTP_PASS=<token>
# AWS SES:   SMTP_HOST=email-smtp.us-east-1.amazonaws.com  SMTP_USER/PASS from SES console
SMTP_HOST=smtp.provider.com
SMTP_PORT=465
SMTP_USER=noreply@preuni.com.br
SMTP_PASS=
