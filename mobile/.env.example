EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Google Sign-In (issue #39). OAuth client IDs are safe to expose client-side
# (only a client secret would be sensitive, and this flow needs none).
# Create at https://console.cloud.google.com/apis/credentials -- an "iOS"
# type, an "Android" type, and a "Web application" type (used for Expo Go /
# web) all pointing at the same Google Cloud project.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
